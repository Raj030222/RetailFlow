# Python
.venv/
venv/
__pycache__/
.pytest_cache/
*.py[cod]

# Spark scratch data and local warehouse metadata
spark-temp/
spark-warehouse/
metastore_db/
.sparkStaging/
*.crc

# Logs and local runtime state
logs/
*.log
.retailflow-api.lock
*.sqlite3
*.sqlite
