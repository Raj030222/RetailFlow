# Outputs - exclude execution runs, retain curated submission samples
outputs/runs/
outputs/tmp/
outputs/temp/
# Curated Parquet examples under outputs/samples/ are intentionally included.

# Reports - retain verified reports
# Do not ignore the entire reports directory
reports/.benchmark-*.tmp
reports/.benchmark-*/

# Backups
backups/

# Frontend
frontend/node_modules/
node_modules/
frontend/dist/

# Environment variables and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db
